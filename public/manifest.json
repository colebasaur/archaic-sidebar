{
  "manifest_version": 3,
  "name": "Archaic Sidebar",
  "version": "0.1.0",
  "description": "Arc-style sidebar, launcher, and auto-archive for Chrome.",
  "minimum_chrome_version": "141",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "alarms",
    "scripting",
    "activeTab",
    "offscreen",
    "bookmarks",
    "history",
    "search",
    "favicon"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Toggle sidebar",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "options/index.html",
  "web_accessible_resources": [
    {
      "resources": ["launcher/index.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "nav-down": {
      "suggested_key": { "default": "Alt+J", "mac": "MacCtrl+J" },
      "description": "Sidebar: move down"
    },
    "nav-up": {
      "suggested_key": { "default": "Alt+K", "mac": "MacCtrl+K" },
      "description": "Sidebar: move up"
    },
    "nav-in": {
      "suggested_key": { "default": "Alt+L", "mac": "MacCtrl+L" },
      "description": "Sidebar: into folder / open closed pin"
    },
    "nav-out": {
      "suggested_key": { "default": "Alt+H", "mac": "MacCtrl+H" },
      "description": "Sidebar: collapse folder / out of folder"
    },
    "toggle-sidebar": { "description": "Toggle sidebar" },
    "open-launcher": { "description": "Open launcher over current page" },
    "copy-url": { "description": "Copy URL" },
    "copy-markdown": { "description": "Copy URL as Markdown link" },
    "copy-title": { "description": "Copy page title" },
    "copy-clean-url": { "description": "Copy URL without tracking params" },
    "toggle-pin": { "description": "Pin / unpin current tab" },
    "rename-tab": { "description": "Rename current tab" },
    "reset-pinned": { "description": "Reset pinned tab to its saved URL" },
    "archive-tab": { "description": "Archive current tab now" },
    "reopen-archived": { "description": "Reopen last archived tab" },
    "duplicate-tab": { "description": "Duplicate current tab" }
  }
}
